  "version": "0.1.0",
  "type": "module",
  "description": "Auto-generates token and invoice after an appointment is booked",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -n 'build,serve' -c 'green.bold,blue.bold' \"npm run build:watch\" \"npm run preview\"",
    "build:watch": "vite build --watch",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@tanstack/react-query": "^5.72.2",
    "lucide-react": "^1.59.0",
    "raviger": "^5.0.0-2",
    "react-i18next": "^15.4.1",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "concurrently": "^10.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.2.6"
  }
